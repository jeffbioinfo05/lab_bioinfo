# Amostras que passaram no filtro de qualidade
def passed_samples():
    passed = []
    status_dir = os.path.join(RESULTS, "filtered")
    for s in SAMPLE_IDS:
        status_file = os.path.join(status_dir, s, "filter_status.tsv")
        if os.path.exists(status_file):
            with open(status_file) as f:
                lines = f.readlines()
                if len(lines) > 1 and "PASSED" in lines[1]:
                    passed.append(s)
    return passed if passed else SAMPLE_IDS  # antes do filtro, usa todos

